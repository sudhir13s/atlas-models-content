{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/models/model.schema.json",
  "title": "model",
  "allOf": [{ "$ref": "_shared.schema.json#/$defs/base" }],
  "properties": {
    "type": { "const": "model" },
    "organization": {
      "type": "string",
      "pattern": "^organization/[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "FK → organization/<slug>: the creator of the model (never an uploader of a copy)"
    },
    "release_date": {
      "type": "string",
      "description": "ISO date; for records built from Hugging Face, the day the repository was created"
    },
    "release_year": { "type": "integer" },
    "release_month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "license": {
      "type": "string",
      "pattern": "^license/[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "FK → license/<slug>; absent when the licence has no record, then `license_note` names it"
    },
    "license_note": {
      "type": "string",
      "description": "the licence name exactly as the source gives it, when no license record matches"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "other names the model is known by (repository ids, earlier slugs)"
    },
    "variants": {
      "type": "array",
      "description": "quantised or repackaged copies of this model, published as repositories of their own",
      "items": {
        "type": "object",
        "required": ["name", "format", "address", "publisher"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "format": {
            "type": "string",
            "enum": ["gguf", "awq", "gptq", "fp8", "nvfp4", "bnb-4bit", "w8a8", "mlx", "other"]
          },
          "address": { "type": "string", "format": "uri" },
          "publisher": { "type": "string", "minLength": 1, "description": "Hugging Face handle of whoever published the copy" }
        }
      }
    },
    "signal_strength": { "type": "string", "enum": ["high", "medium", "low"] },
    "architecture_id": { "type": "string", "description": "FK → architecture-era/<slug>" },
    "model_category": {
      "type": "string",
      "description": "kind of model; `language` covers decoder-only and encoder-decoder text models"
    },
    "tasks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^task/[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "description": "FKs → task/<slug>; the jobs this model does"
    },
    "parameters_active_b": { "type": "number" },
    "total_parameters": { "type": "integer" },
    "context_window_tokens": { "type": "integer" },
    "summary": { "type": "string", "description": "absent means the record has no prose yet; the prose queue writes it" },
    "why_it_matters": { "type": "string" },
    "fingerprint": {
      "type": "object",
      "description": "values a source gives; one it lacks stays absent. Depth and width are the least a fingerprint says.",
      "required": ["num_layers", "hidden_size"],
      "properties": {
        "attention_type": { "type": "string" },
        "num_layers": { "type": "integer" },
        "attention_heads": { "type": "integer" },
        "kv_heads": { "type": "integer" },
        "head_size": { "type": "integer" },
        "hidden_size": { "type": "integer" },
        "intermediate_size": { "type": "integer" },
        "context_window_tokens": { "type": "integer" },
        "vocabulary_size": { "type": "integer" },
        "activation_function": { "type": "string" },
        "normalization": { "type": "string" },
        "positional_encoding": { "type": "string" },
        "rope_theta": { "type": ["number", "null"] },
        "parameters_active_b": { "type": "number" },
        "kv_cache_rating": { "type": "string", "enum": ["low", "medium", "high"] },
        "key_detail": { "type": "string" }
      }
    },
    "moe_config": {
      "type": ["object", "null"],
      "properties": {
        "expert_count": { "type": "integer" },
        "active_experts": { "type": "integer" },
        "shared_expert": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "filters": {
      "type": "object",
      "properties": {
        "size_category": { "type": "string", "enum": ["tiny", "small", "medium", "large", "xlarge"] },
        "is_quantized": { "type": "boolean" },
        "quant_format": { "type": "string" },
        "is_moe": { "type": "boolean" },
        "is_gated": { "type": "boolean", "description": "access needs approval on Hugging Face" },
        "pipeline_tag": { "type": "string" },
        "library": { "type": "string", "description": "Hugging Face library_name, for example transformers" },
        "attention_type": { "type": "string" }
      }
    },
    "hub_signals": {
      "type": "object",
      "description": "numbers that change, copied from Hugging Face by code; owned by the jobs",
      "required": ["observed_at", "source"],
      "properties": {
        "downloads_30d": { "type": "integer", "minimum": 0 },
        "likes": { "type": "integer", "minimum": 0 },
        "last_modified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "observed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": { "type": "string", "format": "uri" }
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "score"],
        "properties": {
          "name": { "type": "string" },
          "score": { "type": "number" },
          "score_display": { "type": "string" },
          "method": { "type": "string" },
          "self_reported": { "type": "boolean" },
          "source_url": { "type": "string" }
        }
      }
    },
    "lineage": {
      "type": "object",
      "properties": {
        "parents": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "required": ["organization", "model_category"],
  "anyOf": [{ "required": ["license"] }, { "required": ["license_note"] }],
  "if": {
    "properties": { "model_category": { "const": "language" } },
    "required": ["model_category"]
  },
  "then": {
    "anyOf": [
      { "required": ["fingerprint"] },
      {
        "description": "a gated repository whose config.json cannot be read has no fingerprint yet",
        "required": ["filters"],
        "properties": {
          "filters": { "required": ["is_gated"], "properties": { "is_gated": { "const": true } } }
        }
      }
    ]
  }
}
