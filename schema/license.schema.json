{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/models/license.schema.json",
  "title": "license",
  "allOf": [{ "$ref": "_shared.schema.json#/$defs/base" }],
  "properties": {
    "type": { "const": "license" },
    "name": { "type": "string" },
    "spdx_id": { "type": "string" },
    "category": { "type": "string", "enum": ["permissive", "copyleft", "restricted", "custom"] },
    "url": { "type": "string", "format": "uri" },
    "permissions": {
      "type": "object",
      "properties": {
        "commercial_use": { "type": "boolean" },
        "modification": { "type": "boolean" },
        "distribution": { "type": "boolean" },
        "fine_tuning": { "type": "boolean" },
        "output_training": { "type": "boolean" },
        "patent_grant": { "type": "boolean" },
        "private_use": { "type": "boolean" }
      }
    },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "models_using": { "type": "array", "items": { "type": "string" }, "description": "FKs → model/<slug>" },
    "summary": { "type": "string" }
  },
  "required": ["name", "category", "permissions", "summary"]
}
