{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/models/architecture-era.schema.json",
  "title": "architecture-era",
  "allOf": [{ "$ref": "_shared.schema.json#/$defs/base" }],
  "properties": {
    "type": { "const": "architecture-era" },
    "name": { "type": "string" },
    "era": { "type": "string", "enum": ["early", "foundation", "scaling", "post-transformer"] },
    "era_range": { "type": "string" },
    "year": { "type": "integer" },
    "family": {
      "type": "string",
      "enum": ["classical-nn", "classical-dl", "llm", "vision", "generation", "multimodal", "other"]
    },
    "core_innovation": { "type": "string" },
    "description": { "type": "string" },
    "long_description": { "type": "string" },
    "key_features": { "type": "array", "items": { "type": "string" } },
    "key_models": { "type": "array", "items": { "type": "string" } },
    "paper_title": { "type": "string" },
    "paper_url": { "type": "string", "format": "uri" },
    "diagram_url": { "type": "string" },
    "influenced_by": { "type": "array", "items": { "type": "string" }, "description": "FKs → architecture-era/<slug>" },
    "led_to": { "type": "array", "items": { "type": "string" }, "description": "FKs → architecture-era/<slug>" },

    "eli5": {
      "type": "string",
      "description": "Plain-English explanation, zero jargon, 2-3 lines. The 'anyone can understand' layer."
    },
    "analogy": {
      "type": "object",
      "description": "One vivid real-world metaphor that makes the mechanism click.",
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "narrative": {
      "type": "object",
      "description": "The research-story arc, four tight paragraphs.",
      "properties": {
        "motivation": { "type": "string" },
        "approach": { "type": "string" },
        "solution": { "type": "string" },
        "outcome": { "type": "string" }
      }
    },
    "build_steps": {
      "type": "array",
      "description": "Ordered 'how it is constructed' steps; each a plain-language title + detail.",
      "items": {
        "type": "object",
        "required": ["title", "detail"],
        "properties": {
          "title": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "key_equation": {
      "type": "object",
      "description": "The one defining formula, in plain words.",
      "required": ["latex", "plain"],
      "properties": {
        "latex": { "type": "string", "description": "KaTeX/LaTeX source, no surrounding $ delimiters" },
        "plain": { "type": "string", "description": "What the equation says, in plain English" },
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["symbol", "meaning"],
            "properties": {
              "symbol": { "type": "string" },
              "meaning": { "type": "string" }
            }
          }
        }
      }
    },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "weaknesses": { "type": "array", "items": { "type": "string" } },
    "diagram": {
      "type": "string",
      "description": "Mermaid diagram source (with or without the ```mermaid fence). Rendered client-side, theme-aware."
    },
    "diagram_svg": {
      "type": "string",
      "description": "Hand-authored SVG figure (one <svg class=\"atlas-figure\"> element) using the d-* classes; preferred over `diagram`."
    },
    "diagram_caption": { "type": "string" },
    "underlying_model_note": {
      "type": "string",
      "description": "One or two sentences a consumer prints above a second figure, the whole architecture of one catalog model of this record, saying how that model relates to the idea the first figure shows. Every statement rests on an entry of `sources`."
    },
    "notable_models": {
      "type": "array",
      "description": "Landmark models in this family, each with what it proved.",
      "items": {
        "type": "object",
        "required": ["name", "note"],
        "properties": {
          "name": { "type": "string" },
          "year": { "type": "integer" },
          "note": { "type": "string", "description": "what this model proved / why it matters" }
        }
      }
    },
    "resources": {
      "type": "array",
      "description": "Curated open-access learning links.",
      "items": {
        "type": "object",
        "required": ["kind", "title", "url"],
        "properties": {
          "kind": { "type": "string", "enum": ["paper", "blog", "video", "course", "tutorial"] },
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "variants": {
      "type": "array",
      "description": "Named structural variants of the architecture, each with the model families built that way.",
      "items": {
        "type": "object",
        "required": ["name", "subtitle", "models"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string", "minLength": 1 },
          "models": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "visual": {
      "$ref": "hyperparameter.schema.json#/$defs/distribution_visual",
      "description": "A computed figure for the Worked Example: the consumer draws softmax bars from the example scores (attention scores, router scores), with `panel_titles` naming what each panel shows."
    },
    "comparison": {
      "type": "object",
      "description": "What changed from the approach that came before, as a small table: one row per aspect, each with its source.",
      "additionalProperties": false,
      "required": ["before", "after", "rows"],
      "properties": {
        "before": { "type": "string", "minLength": 1, "description": "the earlier approach, as a column heading" },
        "after": { "type": "string", "minLength": 1, "description": "this architecture, as a column heading" },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aspect", "before", "after", "source"],
            "properties": {
              "aspect": { "type": "string", "minLength": 1 },
              "before": { "type": "string", "minLength": 1 },
              "after": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "format": "uri", "description": "the url of one entry of this record's sources" }
            }
          }
        }
      }
    },
    "key_numbers": {
      "type": "object",
      "description": "Published configuration numbers (the original paper's model sizes, or the expert counts of named models), as a table; every row names its source.",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cells", "source"],
            "properties": {
              "cells": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1 }, "description": "one cell per entry of columns, in the same order" },
              "source": { "type": "string", "format": "uri", "description": "the url of one entry of this record's sources" }
            }
          }
        }
      }
    },
    "misunderstandings": {
      "type": "array",
      "description": "Common misreadings of the architecture, each corrected from a source.",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["misunderstanding", "truth", "source"],
        "properties": {
          "misunderstanding": { "type": "string", "minLength": 1 },
          "truth": { "type": "string", "minLength": 1, "description": "what is actually true; Markdown" },
          "source": { "type": "string", "format": "uri", "description": "the url of one entry of this record's sources" }
        }
      }
    },
    "learn_first": {
      "type": "array",
      "description": "Content-driven prerequisites (replaces the hardcoded PREREQS map).",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string" },
          "href": { "type": "string" },
          "tag": { "type": "string" }
        }
      }
    }
  },
  "required": ["name", "era", "year", "family", "core_innovation"]
}
