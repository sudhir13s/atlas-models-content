{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/models/fine-tuning-method.schema.json",
  "title": "fine-tuning-method",
  "allOf": [{ "$ref": "_shared.schema.json#/$defs/base" }],
  "properties": {
    "type": { "const": "fine-tuning-method" },
    "method_type": { "type": "string", "enum": ["peft", "full", "rlhf", "preference", "distillation"] },
    "memory_profile": { "type": "string", "enum": ["low", "medium", "high"] },
    "summary": { "type": "string" },
    "when_to_use": { "type": "string" },
    "related_hyperparameters": { "type": "array", "items": { "type": "string" }, "description": "FKs → hyperparameter/<slug>" },
    "diagram_url": { "type": "string" }
  },
  "required": ["method_type", "memory_profile", "summary", "when_to_use"]
}
