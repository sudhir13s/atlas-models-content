{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/models/fine-tuning-method.schema.json",
  "title": "fine-tuning-method",
  "allOf": [{ "$ref": "_shared.schema.json#/$defs/base" }],
  "properties": {
    "type": { "const": "fine-tuning-method" },
    "method_type": { "type": "string", "enum": ["peft", "full", "rlhf", "preference", "distillation"] },
    "memory_profile": { "type": "string", "enum": ["low", "medium", "high"] },
    "summary": { "type": "string" },
    "when_to_use": { "type": "string", "description": "one sentence; a schema 2.8 record explains it in full in its When To Use section" },
    "related_hyperparameters": { "type": "array", "items": { "type": "string" }, "description": "FKs → hyperparameter/<slug>" },
    "diagram_url": { "type": "string" },
    "typical_values": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "hyperparameter.schema.json#/$defs/typical_value" },
      "description": "settings a cited source used for this method, one row each with the source's url; drawn as the Published settings table"
    },
    "mistakes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "$ref": "hyperparameter.schema.json#/$defs/mistake" }
    },
    "profile": { "$ref": "#/$defs/profile" },
    "visual": {
      "oneOf": [
        { "$ref": "#/$defs/memory_terms_visual" },
        { "$ref": "#/$defs/adapter_size_visual" },
        { "$ref": "#/$defs/memory_bars_visual" },
        { "$ref": "#/$defs/dpo_loss_visual" },
        { "$ref": "#/$defs/orpo_loss_visual" },
        { "$ref": "#/$defs/kl_reward_visual" }
      ]
    }
  },
  "required": ["method_type", "memory_profile", "summary", "when_to_use"],
  "$defs": {
    "bar_label": { "type": "string", "minLength": 1, "maxLength": 14, "description": "printed beside a bar, so kept to one short phrase" },
    "caption": { "type": "string", "minLength": 1, "description": "what is drawn; says so when the numbers are an example" },
    "profile": {
      "type": "object",
      "description": "this method's row of the table comparing all methods, each cell from the cited source; the consumer assembles the table from every record's row",
      "additionalProperties": false,
      "required": ["trains", "models_in_training", "data", "stages", "source"],
      "properties": {
        "trains": { "type": "string", "minLength": 1, "description": "which weights receive updates" },
        "models_in_training": { "type": "string", "minLength": 1, "description": "the models held while training, trained and frozen" },
        "data": { "type": "string", "minLength": 1, "description": "the data the method learns from" },
        "stages": { "type": "string", "minLength": 1, "description": "the training stages it needs" },
        "source": { "type": "string", "format": "uri", "description": "the url of one entry of this record's sources" }
      }
    },
    "memory_terms_visual": {
      "type": "object",
      "description": "the memory of training every weight: each term's bytes per weight times parameters, in gigabytes (10^9 bytes), with the sum",
      "additionalProperties": false,
      "required": ["kind", "parameters", "terms", "caption"],
      "properties": {
        "kind": { "const": "memory_terms" },
        "parameters": { "type": "number", "exclusiveMinimum": 0 },
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "bytes"],
            "properties": { "label": { "$ref": "#/$defs/bar_label" }, "bytes": { "type": "number", "exclusiveMinimum": 0 } }
          }
        },
        "caption": { "$ref": "#/$defs/caption" }
      }
    },
    "adapter_size_visual": {
      "type": "object",
      "description": "one frozen matrix of rows × columns numbers against LoRA's two matrices, rank × (rows + columns) numbers, for each rank",
      "additionalProperties": false,
      "required": ["kind", "rows", "columns", "ranks", "caption"],
      "properties": {
        "kind": { "const": "adapter_size" },
        "rows": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "ranks": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "integer", "minimum": 1 } },
        "caption": { "$ref": "#/$defs/caption" }
      }
    },
    "memory_bars_visual": {
      "type": "object",
      "description": "published memory figures, drawn as given; one panel per comparison, each on its own scale",
      "additionalProperties": false,
      "required": ["kind", "panels", "caption"],
      "properties": {
        "kind": { "const": "memory_bars" },
        "panels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "bars"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "bars": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "gigabytes", "is_lower_bound"],
                  "properties": {
                    "label": { "$ref": "#/$defs/bar_label" },
                    "gigabytes": { "type": "number", "exclusiveMinimum": 0 },
                    "is_lower_bound": { "type": "boolean", "description": "true when the source says more than this" }
                  }
                }
              }
            }
          }
        },
        "caption": { "$ref": "#/$defs/caption" }
      }
    },
    "answer_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chosen", "rejected"],
      "properties": { "chosen": { "type": "number", "maximum": 0 }, "rejected": { "type": "number", "maximum": 0 } }
    },
    "dpo_loss_visual": {
      "type": "object",
      "description": "the DPO loss of one pair, −ln σ(β·[(log π − log π_ref)(chosen) − (log π − log π_ref)(rejected)]), from sequence log-probabilities, against the loss when the policy still equals the reference",
      "additionalProperties": false,
      "required": ["kind", "beta", "policy", "reference", "caption"],
      "properties": {
        "kind": { "const": "dpo_loss" },
        "beta": { "type": "number", "exclusiveMinimum": 0 },
        "policy": { "$ref": "#/$defs/answer_pair" },
        "reference": { "$ref": "#/$defs/answer_pair" },
        "caption": { "$ref": "#/$defs/caption" }
      }
    },
    "orpo_loss_visual": {
      "type": "object",
      "description": "the ORPO loss of one pair from each answer's average token log-probability: P = e^average, odds = P ÷ (1 − P), L_OR = −ln σ(ln(odds chosen ÷ odds rejected)), L = −average(chosen) + λ·L_OR",
      "additionalProperties": false,
      "required": ["kind", "lambda", "average_log_probabilities", "caption"],
      "properties": {
        "kind": { "const": "orpo_loss" },
        "lambda": { "type": "number", "exclusiveMinimum": 0 },
        "average_log_probabilities": { "$ref": "#/$defs/answer_pair" },
        "caption": { "$ref": "#/$defs/caption" }
      }
    },
    "kl_reward_visual": {
      "type": "object",
      "description": "the reward of one answer after the KL penalty, score − β·Σ ln(policy ÷ reference) over its tokens, for each β",
      "additionalProperties": false,
      "required": ["kind", "score", "betas", "policy", "reference", "caption"],
      "properties": {
        "kind": { "const": "kl_reward" },
        "score": { "type": "number" },
        "betas": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "policy": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "description": "the policy's probability of each token of the answer" },
        "reference": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "description": "the reference model's probability of the same tokens, in the same order" },
        "caption": { "$ref": "#/$defs/caption" }
      }
    }
  }
}
