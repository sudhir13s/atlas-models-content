{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/models/parameter.schema.json",
  "title": "parameter",
  "allOf": [{ "$ref": "_shared.schema.json#/$defs/base" }],
  "properties": {
    "type": { "const": "parameter" },
    "name": { "type": "string", "description": "exact config key, e.g. num_hidden_layers" },
    "importance": { "type": "string", "enum": ["critical", "important", "optional"] },
    "priority": { "type": "integer", "minimum": 1, "description": "criticality rank; 1 = most impactful" },
    "applies_to": {
      "type": "array",
      "items": { "type": "string", "enum": ["llm", "transformer", "moe", "ssm", "cnn", "rnn", "gan", "diffusion", "mlp", "hybrid"] },
      "description": "architecture families this structural parameter appears in"
    },
    "range": { "type": "string" },
    "controls": { "type": "string" },
    "if_increased": { "type": "string" },
    "if_decreased": { "type": "string" },
    "formula": { "type": "string", "description": "how this parameter contributes to the parameter count" }
  },
  "required": ["name", "importance", "priority"]
}
